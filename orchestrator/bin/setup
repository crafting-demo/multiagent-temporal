#!/bin/bash
# Installs Go and the Temporal CLI into ~/.local when missing, then builds the
# worker and deliveryctl into bin/.build. Idempotent; runs as the checkout's
# build hook when the sandbox is created.
set -euo pipefail
cd "$(dirname "$0")/.."

GO_VERSION=1.26.2
export PATH="$HOME/.local/go/bin:$HOME/.local/bin:$PATH"

case "$(uname -m)" in
  aarch64|arm64) ARCH=arm64 ;;
  *) ARCH=amd64 ;;
esac
mkdir -p "$HOME/.local/bin"

if ! command -v temporal >/dev/null 2>&1; then
  curl -sSfL "https://temporal.download/cli/archive/latest?platform=linux&arch=$ARCH" \
    | tar -xz -C "$HOME/.local/bin" temporal
fi

if ! go version 2>/dev/null | grep -q "go$GO_VERSION"; then
  tmp="$(mktemp -d)"
  curl -sSfL "https://go.dev/dl/go$GO_VERSION.linux-$ARCH.tar.gz" | tar -xz -C "$tmp"
  rm -rf "$HOME/.local/go"
  mv "$tmp/go" "$HOME/.local/go"
  rmdir "$tmp"
fi

mkdir -p bin/.build
go build -o bin/.build/worker ./cmd/worker
go build -o bin/.build/deliveryctl ./cmd/deliveryctl
echo "built bin/.build/worker and bin/.build/deliveryctl"
